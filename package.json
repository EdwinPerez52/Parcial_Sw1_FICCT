{
  "name": "collab-modeler",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup.ps1",
    "dev": "docker compose up --build",
    "dev:infra": "docker compose up -d postgres redis",
    "dev:web": "corepack pnpm --filter @modeler/web dev",
    "dev:api": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-api.ps1",
    "build": "corepack pnpm --filter @modeler/web build",
    "test": "corepack pnpm --filter @modeler/web test",
    "test:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-all.ps1",
    "mobile:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-mobile.ps1",
    "stop": "docker compose down"
  }
}
