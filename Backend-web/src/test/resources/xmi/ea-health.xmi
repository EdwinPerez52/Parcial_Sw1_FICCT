<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:uml="http://schema.omg.org/spec/UML/2.1">
  <uml:Model xmi:type="uml:Model" xmi:id="health" name="Salud">
    <packagedElement xmi:type="uml:Package" xmi:id="clinical" name="Clinica">
      <packagedElement xmi:type="uml:Package" xmi:id="people" name="Personas">
        <packagedElement xmi:type="uml:PrimitiveType" xmi:id="date" name="Date"/>
        <packagedElement xmi:type="uml:Class" xmi:id="patient" name="Paciente">
          <ownedAttribute xmi:type="uml:Property" xmi:id="birth-date" name="fechaNacimiento" type="date"><lowerValue value="0"/><upperValue value="1"/></ownedAttribute>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="doctor" name="Medico"/>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="care" name="atiende" memberEnd="patient-end doctor-end" navigableOwnedEnd="doctor-end">
        <ownedEnd xmi:type="uml:Property" xmi:id="patient-end" name="paciente" type="patient"><lowerValue value="0"/><upperValue value="*"/></ownedEnd>
        <ownedEnd xmi:type="uml:Property" xmi:id="doctor-end" name="medico" type="doctor"><lowerValue value="1"/><upperValue value="1"/></ownedEnd>
      </packagedElement>
    </packagedElement>
  </uml:Model>
</xmi:XMI>
