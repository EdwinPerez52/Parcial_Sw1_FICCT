<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:uml="http://schema.omg.org/spec/UML/2.1">
  <uml:Model xmi:type="uml:Model" xmi:id="school" name="Colegio">
    <packagedElement xmi:type="uml:PrimitiveType" xmi:id="string" name="String"/>
    <packagedElement xmi:type="uml:Class" xmi:id="student" name="Estudiante">
      <ownedAttribute xmi:type="uml:Property" xmi:id="student-name" name="nombre" type="string"><lowerValue value="1"/><upperValue value="1"/></ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="student-courses" name="cursos" type="course" association="enrollment"><lowerValue value="0"/><upperValue value="*"/></ownedAttribute>
    </packagedElement>
    <packagedElement xmi:type="uml:Class" xmi:id="course" name="Curso"/>
    <packagedElement xmi:type="uml:Association" xmi:id="enrollment" name="inscripcion" memberEnd="course-student student-courses" navigableOwnedEnd="student-courses">
      <ownedEnd xmi:type="uml:Property" xmi:id="course-student" name="estudiante" type="student"><lowerValue value="1"/><upperValue value="1"/></ownedEnd>
    </packagedElement>
  </uml:Model>
</xmi:XMI>
